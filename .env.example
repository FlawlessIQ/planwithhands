# Local-only environment variables (do not commit real values)
# Copy this file to `.env` and fill in the real secrets.

# SendGrid
SENDGRID_API_KEY=
# Optional alias for older scripts
SENDGRID_KEY=

# SendGrid sender defaults (Functions fall back to noreply@planwithhands.com)
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Google Places
GOOGLE_PLACES_API_KEY=
# Optional alias
PLACES_API_KEY=

# App config
APP_BASE_URL=https://plan-with-hands.web.app

# Optional Firestore database binding (most projects use (default))
FIRESTORE_DATABASE_ID=
