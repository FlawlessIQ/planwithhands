rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasUserDoc() {
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function orgMemberships() {
      return hasUserDoc() && userDoc().data.orgMemberships != null
        ? userDoc().data.orgMemberships
        : (hasUserDoc() && userDoc().data.organizationId != null
            ? [ userDoc().data.organizationId ]
            : []);
    }

    function isOrgMember(orgId) {
      return request.auth != null && orgMemberships().hasAny([orgId]);
    }

    function roleInOrg(orgId) {
      return hasUserDoc() && userDoc().data.roles != null && userDoc().data.roles[orgId] != null
        ? userDoc().data.roles[orgId]
        : (hasUserDoc() && userDoc().data.organizationId == orgId && userDoc().data.userRole != null
            ? (userDoc().data.userRole == 2 ? 'admin' : (userDoc().data.userRole == 1 ? 'manager' : 'member'))
            : null);
    }

    function isOrgManagerOrAdmin(orgId) {
      return ['admin','manager'].hasAny([ roleInOrg(orgId) ]);
    }

    // Users
    match /users/{userId} {
      allow read, update, delete: if request.auth != null && (
        request.auth.uid == userId ||
        (resource.data.organizationId != null && isOrgManagerOrAdmin(resource.data.organizationId))
      );
      allow get, list: if request.auth != null;
      allow create: if request.auth != null;

      // User preferences subcollection
      match /preferences/{prefDoc} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Device tokens subcollection (for push notifications)
      match /deviceTokens/{tokenDoc} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Organizations
    match /organizations/{orgId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // Allow updates only by managers/admins for the org document itself
      allow update, delete: if isOrgMember(orgId) && isOrgManagerOrAdmin(orgId);

      // Shifts within organizations
      match /shifts/{shiftId} {
        allow read, write: if request.auth != null;
      }

      // Groups within organizations  
      match /groups/{groupId} {
        allow get, list: if request.auth != null && isOrgMember(orgId);
        allow create, update, delete: if request.auth != null && isOrgManagerOrAdmin(orgId);
      }

      // Notification outbox for organization-wide notifications
      match /notificationOutbox/{notifId} {
        allow read: if request.auth != null && isOrgMember(orgId);
        allow create: if request.auth != null && isOrgManagerOrAdmin(orgId);
        allow update, delete: if false; // Only Cloud Functions should modify after creation
      }

      // Other subcollections
      match /locations/{locId} {
        allow get, list: if request.auth != null;
        allow create, update, delete: if request.auth != null && isOrgManagerOrAdmin(orgId);
        match /daily_checklists/{checklistId} {
          allow get, list, create, update: if request.auth != null;
          allow delete: if request.auth != null && isOrgManagerOrAdmin(orgId);
          match /tasks/{taskId} {
            allow get, list, create, update: if request.auth != null;
            allow delete: if request.auth != null;
          }
        }
      }
      match /checklist_templates/{templateId} {
        allow get, list: if request.auth != null;
        allow create, update, delete: if request.auth != null && isOrgManagerOrAdmin(orgId);
        // Allow managers/admins to manage tasks stored under checklist templates
        match /tasks/{taskId} {
          allow get, list: if request.auth != null;
          allow create, update, delete: if request.auth != null && isOrgManagerOrAdmin(orgId);
        }
      }
      match /jobTypes/{jobTypeId} {
        allow get, list: if request.auth != null && isOrgMember(orgId);
        allow create, update, delete: if request.auth != null && isOrgManagerOrAdmin(orgId);
      }

      // Per-user notification inbox
      match /userNotifications/{notifId} {
        allow get, list: if request.auth != null && resource.data.userId == request.auth.uid;
        allow create, update, delete: if false;
      }

      // Training documents within an organization
      match /training_documents/{docId} {
        // Any authenticated org member can read
        allow get, list: if request.auth != null && isOrgMember(orgId);
        // Only managers/admins of the org can create/update/delete
        allow create, update, delete: if request.auth != null && isOrgManagerOrAdmin(orgId);
      }
    }

    // Top-level per-user notifications collection
    match /userNotifications/{userId} {
      match /notifications/{notifId} {
        allow get, list: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow create, delete: if false; // Only Cloud Functions can create/delete
      }
    }

    // Fallback for legacy top-level collections
    match /locations/{locationId} { allow read, write: if request.auth != null; }
    match /shifts/{shiftId} { allow read, write: if request.auth != null; }
    match /invites/{inviteId} { allow read, write: if true; }

    // Message threads and messages
    match /messageThreads/{threadId} {
      allow read: if request.auth != null && 
        resource.data.recipientUserIds.hasAny([request.auth.uid]);
      allow create, update: if request.auth != null && 
        request.auth.uid in resource.data.recipientUserIds;
      
      match /messages/{messageId} {
        allow read: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/messageThreads/$(threadId)).data.recipientUserIds;
        allow create: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/messageThreads/$(threadId)).data.recipientUserIds;
        allow delete: if request.auth != null && 
          request.auth.uid == resource.data.senderId;
      }
    }

    // Catch-all deny for writes, allow reads for authenticated users
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}