# Firebase Functions environment variables (local-only; do not commit real values)
# Copy to `functions/.env` and fill in real secrets.

# SendGrid
SENDGRID_API_KEY=
# Optional alias
SENDGRID_KEY=

# Sender defaults (optional)
SENDGRID_FROM_EMAIL=noreply@planwithhands.com
SENDGRID_FROM_NAME=Hands App

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Google Places
GOOGLE_PLACES_API_KEY=
# Optional alias
PLACES_API_KEY=

# App config
APP_BASE_URL=https://plan-with-hands.web.app

# Optional Firestore database binding
FIRESTORE_DATABASE_ID=
