# Example env for website/marketing
# For production, set these in your hosting provider (Vercel, Firebase, etc.)

# SendGrid API key (required for real email sending)
SENDGRID_API_KEY=

# Optional: from email (must be verified in SendGrid)
SENDGRID_FROM=no-reply@planwithhands.com

# Optional: destination email
SENDGRID_TO=support@planwithhands.com

# Local dev-only: set to true to allow sending without SENDGRID_API_KEY (payload will be logged)
DEV_FAKE_SEND=true
